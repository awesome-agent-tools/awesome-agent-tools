---
import fs from "node:fs";
import path from "node:path";
import Base from "../../../layouts/Base.astro";
import ObservationValue from "../../../components/ObservationValue.astro";
import PeerContext from "../../../components/PeerContext.astro";
import { loadDb } from "../../../lib/db";
import { displayValue, divergences, groupedKeys, invariantHolds, peerContext } from "../../../lib/queries";

export async function getStaticPaths() {
  const db = loadDb();
  return db.tools.map((tool) => {
    const [owner, name] = tool.id.split("/");
    return { params: { owner, name }, props: { toolId: tool.id } };
  });
}

const { toolId } = Astro.props;
const db = loadDb();
const tool = db.tool(toolId)!;

const measurements = db.measurementsForSubject("tool", tool.id);
const siblings = db.toolsByOwner(tool.owner.type, tool.owner.id).filter((t) => t.id !== tool.id);

// The registered schema is data in its own right — models pick tools partly on
// how it reads — so it is shown verbatim rather than summarised.
let schemaText: string | null = null;
if (tool.schema_file) {
  const p = path.join(process.cwd(), "data", "tools", tool.owner.id, tool.schema_file);
  if (fs.existsSync(p)) schemaText = fs.readFileSync(p, "utf8");
}

const observationFor = (key: string) => tool.observations.find((o) => o.key === key);

/**
 * The top of the page. `headline: true` in data/observation-keys.yaml already
 * marks the facts that clear all four filters in product.md §5 — changes a
 * decision, not derivable from cheap signals, invisible to the user, one number
 * or sentence. Reading that field here is what keeps the first screen from
 * weighing a line-number format the same as a lost edit.
 */
const headline = tool.capabilities.flatMap((c) =>
  db
    .keysForCapability(c.id)
    .filter((k) => k.headline && observationFor(k.key))
    .map((k) => ({
      key: k,
      capability: c.id,
      observation: observationFor(k.key)!,
      context: peerContext(db, c.id, k.key, observationFor(k.key)),
    })),
);

// The contract verdict, which is the one place this site allows itself a
// pass/fail. Unverified invariants are counted apart rather than assumed to
// hold — an unchecked contract is not a kept one.
const invariants = tool.capabilities.flatMap((c) =>
  db
    .keysForCapability(c.id)
    .filter((k) => k.class === "invariant")
    .map((k) => invariantHolds(k, observationFor(k.key))),
);
const held = invariants.filter((v) => v === true).length;
const failed = invariants.filter((v) => v === false).length;
const unchecked = invariants.filter((v) => v === null).length;

// Stated in full rather than left to arithmetic: "1 of 3 hold · 1 fails" makes
// the reader work out that the third was never checked, and an unchecked
// contract is the state this site most often has to defend as its own claim.
const verdict =
  invariants.length === 0
    ? null
    : failed === 0 && unchecked === 0
      ? `${held} invariants · all hold`
      : [
          `${held} of ${invariants.length} invariants hold`,
          failed > 0 ? `${failed} fails` : null,
          unchecked > 0 ? `${unchecked} unverified` : null,
        ]
          .filter(Boolean)
          .join(" · ");

// Anything already stated above is dropped here rather than repeated. For
// claude-code/read that removes the staleness check, whose rarity the headline
// row already carries.
const diverges = divergences(db, tool).filter((d) => !headline.some((h) => h.key.key === d.key.key));

const capabilityGroups = tool.capabilities.map((c) => ({
  capability: db.capability(c.id)!,
  role: c.role,
  groups: groupedKeys(db, c.id)
    .map((g) => {
      const keys = g.keys.filter((k) => observationFor(k.key));
      return {
        group: g.group,
        keys,
        recorded: keys.filter((k) => observationFor(k.key)!.status === "ok").length,
      };
    })
    .filter((g) => g.keys.length > 0),
}));

const fmt = (d: Date) => d.toLocaleDateString("en-CA");
---

<Base
  title={`${tool.ownerRef.name} ${tool.exposed_name} — tool reference`}
  description={`What ${tool.ownerRef.name}'s ${tool.exposed_name} tool does, read from source.`}
  section="tools"
>
  <div class="bd">
    <div class="cap">
      <div class="eyebrow">
        Tool ·{" "}
        <a href={tool.ownerRef.href}>{tool.ownerRef.name}</a>
        {tool.ownerRef.vendor && ` · ${tool.ownerRef.vendor}`}
      </div>
      <h1 style="font-family:var(--mono);font-size:32px">{tool.exposed_name}</h1>

      <div class="meta">
        <span>{tool.id}</span>
        {
          tool.capabilities.map((c) => (
            <a href={`/tools/${c.id}`}>
              {db.capability(c.id)?.name ?? c.id} · {c.role}
            </a>
          ))
        }
        {tool.source && <a href={tool.source.url}>source</a>}
        {tool.source?.commit && <span>@{tool.source.commit}</span>}
        {tool.source && <span>checked {fmt(tool.source.checked_at)}</span>}
        {!tool.source && <span>not source-verified</span>}
      </div>

      {
        headline.length > 0 && (
          <div class="facts">
            <div class="hd">
              <span class="l">What matters here</span>
              {verdict && <span class="v">{verdict}</span>}
            </div>
            <ul>
              {headline.map((h) => (
                <li>
                  <span class="k">
                    <a href={`#${h.key.key}`}>{h.key.short ?? h.key.label}</a>
                    {h.key.class === "invariant" && <span class="badge">invariant</span>}
                  </span>
                  <span class="mine">
                    <ObservationValue
                      keyDef={h.key}
                      observation={h.observation}
                      fallbackSource={tool.source}
                    />
                  </span>
                  <span class="rest">
                    <PeerContext
                      keyDef={h.key}
                      observation={h.observation}
                      context={h.context}
                      detail={false}
                    />
                  </span>
                </li>
              ))}
            </ul>
            <p class="prose note">
              The facts the registry marks decision-changing, with how the other
              implementations answered. An invariant may be shown as pass/fail; a design
              choice never is, however unusual it looks.
            </p>
          </div>
        )
      }

      {
        diverges.length > 0 && (
          <div class="diverge">
            <div class="l" style="font-size:11px;letter-spacing:.12em;text-transform:uppercase;color:var(--faint)">
              How this differs from most implementations
            </div>
            <ul>
              {diverges.map((d) => (
                <li>
                  <span class="k">
                    <a href={`#${d.key.key}`}>{d.key.label}</a>
                    {d.key.class === "invariant" && (
                      <span class="badge" style="margin-left:6px">
                        invariant
                      </span>
                    )}
                  </span>
                  <span class="mine">{displayValue(d.key, d.mine)}</span>
                  <span class="rest">
                    vs {displayValue(d.key, d.majority)} in {d.majorityCount} of {d.peers}
                  </span>
                </li>
              ))}
            </ul>
            <p class="prose" style="font-size:13px;color:var(--mute);margin-top:14px">
              Derived by comparing every recorded value against the other implementations of the same
              capability. Differing is not a defect unless the row is marked an invariant.
            </p>
          </div>
        )
      }

      {
        tool.via && (
          <p class="prose">
            <b>Reached indirectly.</b> {tool.via}
          </p>
        )
      }
      {tool.notes && <p class="prose">{tool.notes}</p>}

      {/* Both blocks render whether or not the text exists. product.md calls
          these data in their own right, and a section that silently disappears
          when unrecorded tells the reader the tool has no description rather
          than that nobody has captured it yet. */}
      <div class="sech" style="padding-top:0">
        <h2>Description, as the model sees it</h2>
        <div class="rule"></div>
      </div>
      {
        tool.description_text ? (
          <div class="raw">{tool.description_text}</div>
        ) : (
          <p class="gap">Not recorded yet — the verbatim description has not been captured for this tool.</p>
        )
      }

      <div class="sech" style="padding-top:0">
        <h2>Registered schema</h2>
        <div class="rule"></div>
      </div>
      {
        schemaText ? (
          <div class="raw">{schemaText}</div>
        ) : (
          <p class="gap">Not recorded yet — the schema as registered has not been captured for this tool.</p>
        )
      }

      {
        capabilityGroups.map(({ capability, groups }) =>
          groups.length === 0 ? null : (
            <>
              <div class="sech" style="padding-top:0">
                <h2>Observed · {capability.name}</h2>
                <div class="rule" />
                <a href={`/tools/${capability.id}`}>compare all →</a>
              </div>
              <div class="scroller">
                <table class="data">
                  <thead>
                    <tr>
                      <th>Fact</th>
                      <th>This tool</th>
                      <th>Across all implementations</th>
                    </tr>
                  </thead>
                  <tbody>
                    {groups.map((group) => (
                      <>
                        <tr class="sec">
                          <td colspan={2}>{group.group}</td>
                          <td class="cnt">
                            {group.recorded} of {group.keys.length} recorded
                          </td>
                        </tr>
                        {group.keys.map((k) => {
                          const o = observationFor(k.key);
                          // Unverified and absent rows stay — dropping them
                          // would claim the behaviour is not there — but they
                          // recede so the recorded facts read first.
                          const thin = !o || o.status !== "ok";
                          return (
                            <tr id={k.key} class={thin ? "thin" : undefined}>
                              <td class="nm wrap" style="width:32%" title={k.description}>
                                {k.label}
                                {k.class === "invariant" && (
                                  <span class="badge" style="margin-left:6px">
                                    invariant
                                  </span>
                                )}
                              </td>
                              <td class="wrap" style="width:30%">
                                <ObservationValue keyDef={k} observation={o} fallbackSource={tool.source} />
                                {o?.note && <div class="dim" style="font-size:12.5px;color:var(--mute);margin-top:3px">{o.note}</div>}
                              </td>
                              <td class="wrap peercell">
                                <PeerContext
                                  keyDef={k}
                                  observation={o}
                                  context={peerContext(db, capability.id, k.key, o)}
                                />
                              </td>
                            </tr>
                          );
                        })}
                      </>
                    ))}
                  </tbody>
                </table>
              </div>
            </>
          ),
        )
      }

      {
        measurements.length > 0 && (
          <>
            <div class="sech" style="padding-top:0">
              <h2>Measured</h2>
              <div class="rule" />
            </div>
            <div class="scroller">
              <table class="data">
                <thead>
                  <tr>
                    <th>Metric</th>
                    <th class="num">Value</th>
                    <th>Protocol</th>
                    <th>Version measured</th>
                    <th>Run</th>
                  </tr>
                </thead>
                <tbody>
                  {measurements.map((m) => (
                    <tr>
                      <td class="nm">{db.metric(m.metric)?.name ?? m.metric}</td>
                      <td class="num">{m.status === "ok" ? (m.value_num ?? m.value) : "—"}</td>
                      <td class="dim mono">
                        {m.run.benchmark}@{m.run.benchmark_version}
                      </td>
                      <td class="dim mono">{m.subject_version ?? "—"}</td>
                      <td class="dim">{fmt(m.run.date)}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </>
        )
      }

      {
        siblings.length > 0 && (
          <>
            <div class="sech" style="padding-top:0">
              <h2>Other tools in {tool.ownerRef.name}</h2>
              <div class="rule" />
              <span class="note">names verbatim, as registered</span>
            </div>
            <div class="toolgrid" style="margin-bottom:46px">
              {siblings.map((s) => (
                <a href={s.href}>
                  <span class="tn">{s.exposed_name}</span>
                  {s.capabilities.length > 0 && (
                    <span class="tc">
                      {db.capability(s.capabilities[0].id)?.name}
                      {s.capabilities.length > 1 && ` +${s.capabilities.length - 1}`}
                    </span>
                  )}
                </a>
              ))}
            </div>
          </>
        )
      }
    </div>
  </div>
</Base>
