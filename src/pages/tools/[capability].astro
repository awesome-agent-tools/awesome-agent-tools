---
import { getCollection, render } from "astro:content";
import Base from "../../layouts/Base.astro";
import ObservationValue from "../../components/ObservationValue.astro";
import { loadDb } from "../../lib/db";
import { groupedKeys, tally } from "../../lib/queries";

export async function getStaticPaths() {
  const db = loadDb();
  return db.capabilities.map((capability) => ({
    params: { capability: capability.id },
    props: { capabilityId: capability.id },
  }));
}

const { capabilityId } = Astro.props;
const db = loadDb();
const capability = db.capability(capabilityId)!;

// The editorial layer is optional. With a `pick` this renders as a buying
// guide; without one the verdict block simply does not exist and the page is a
// reference table. Same template, two shapes — see product.md §7.
const entry = (await getCollection("capabilities")).find((e) => e.id === capabilityId);
const Prose = entry ? (await render(entry)).Content : null;
const pick = entry?.data.pick;
const pickTool = pick ? db.tool(pick.tool) : undefined;

const all = db.toolsByCapability(capabilityId);
// A tool with no observations is present but unstudied. It gets named below the
// table rather than shown as a row of dashes, which would read as "does none of
// this" instead of "we have not checked".
const documented = all.filter((t) => t.observations.some((o) => db.observationKey(o.key)?.capability === capabilityId));
const unstudied = all.filter((t) => !documented.includes(t));

const headlineKeys = db.keysForCapability(capabilityId).filter((k) => k.headline);

// A capability whose tools do two different jobs renders two comparison
// tables; one that does not renders the single table it always did. The
// assignment comes from each tool's own observation of `split.key`, so a tool
// whose kind is unverified sits in the candidate table and in neither
// comparison — the same rule that keeps unstudied tools out of the tables,
// one level up.
const split = capability.split;
const kindOf = (tool: (typeof documented)[number]) => {
  if (!split) return undefined;
  const o = tool.observations.find((x) => x.key === split.key);
  return o?.status === "ok" ? String(o.value) : undefined;
};

const rawTables = split
  ? split.parts.map((part) => ({
      partId: part.id as string,
      label: part.label as string | undefined,
      tools: documented.filter((t) => {
        const kind = kindOf(t);
        return kind !== undefined && part.match.includes(kind);
      }),
      groups: groupedKeys(db, capabilityId, part.id),
    }))
  : [{ partId: "", label: undefined, tools: documented, groups: groupedKeys(db, capabilityId) }];

// A key that applies to both halves renders in both tables, so the row id has
// to be assigned once rather than emitted twice. The first table to carry a
// key keeps the bare key as its anchor — that is the one an outside page cites
// — and any repeat gets a qualified one.
const seenAnchors = new Set<string>();
const tables = rawTables
  .filter((t) => t.tools.length > 0 && t.groups.length > 0)
  .map((t) => ({
    ...t,
    groups: t.groups.map((g) => ({
      group: g.group,
      keys: g.keys.map((k) => {
        const anchor = seenAnchors.has(k.key) ? `${t.partId}-${k.key}` : k.key;
        seenAnchors.add(k.key);
        return { k, anchor };
      }),
    })),
  }));

const splitKey = split ? db.observationKey(split.key) : undefined;

// Tools and harnesses are not the same count. Code search and shell register
// two or three tools per harness, so reporting the tool count as a harness
// count overstates the survey by roughly double.
const unstudiedOwners = new Set(unstudied.map((t) => t.ownerRef.id)).size;
const plural = (n: number, one: string, many: string) => (n === 1 ? one : many);

const runs = db.benchmarks
  .filter((b) => b.capability === capabilityId)
  .flatMap((b) => db.runsForBenchmark(b.id).map((run) => ({ benchmark: b, run })));

// Headline figures are computed from the same rows the table below renders, so
// the top of the page cannot drift away from the bottom of it.
const kpis = (entry?.data.kpi ?? []).map((k) => {
  const derive = k.derive;
  if (!derive) return { value: k.value!, label: k.label, sub: k.sub };
  const t = tally(db, capabilityId, derive.key);
  const value =
    derive.as === "ratio"
      ? `${t.values.find((v) => v.value === derive.counts)?.count ?? 0}/${t.answered}`
      : String(t.values.length);
  return { value, label: k.label, sub: k.sub };
});

const updated = entry?.data.updated ?? db.lastUpdated();
const fmt = (d: Date) => d.toLocaleDateString("en-CA");
---

<Base
  title={`${capability.name} — ${capability.question}`}
  description={capability.description}
  section="capabilities"
>
  <div class="bd">
    <div class="cap">
      <div class="eyebrow">
        Capability · {capability.name} · updated {fmt(updated)}
      </div>
      <h1>{capability.question}</h1>

      {
        pick && (
          <>
            <div class="verdict">
              <div class="l">{pick.label}</div>
              <div class="p">{pickTool ? pickTool.exposed_name : pick.tool}</div>
              <div class="r">{pick.reason}</div>
            </div>
            {entry!.data.switch_when.length > 0 && (
              <div class="exc">
                {entry!.data.switch_when.map((s) => (
                  <div>
                    <span class="i">{s.situation}</span>
                    <span class="t">{s.href ? <a href={s.href}>{s.then} →</a> : s.then}</span>
                  </div>
                ))}
              </div>
            )}
          </>
        )
      }

      {
        kpis.length > 0 && (
          <>
            <div class="kpi">
              {kpis.map((k) => (
                <div>
                  <div class="n tnum">{k.value}</div>
                  <div class="l">
                    {k.label}
                    {k.sub && (
                      <>
                        <br />
                        {k.sub}
                      </>
                    )}
                  </div>
                </div>
              ))}
            </div>
            <div class="method">{capability.description}</div>
          </>
        )
      }

      {Prose && <div class="prose"><Prose /></div>}

      {
        runs.length > 0 && (
          <>
            <div class="sech" style="padding-top:0">
              <h2>Measured</h2>
              <div class="rule" />
            </div>
            {runs.map(({ benchmark, run }) => (
              <div class="scroller">
                <table class="data">
                  <caption>
                    {benchmark.name} · {benchmark.id}@{run.benchmark_version} · run {fmt(run.date)}
                    {run.draft && <span class="badge warn" style="margin-left:8px">Sample data</span>}
                    {run.post && (
                      <>
                        {" · "}
                        <a href={`/posts/${run.post}`}>method</a>
                      </>
                    )}
                  </caption>
                  <thead>
                    <tr>
                      <th>Subject</th>
                      <th>Metric</th>
                      <th class="num">Value</th>
                      <th>Version measured</th>
                      <th>Status</th>
                    </tr>
                  </thead>
                  <tbody>
                    {run.measurements.map((m) => {
                      const label = db.subjectLabel(m.subject);
                      const metric = db.metric(m.metric);
                      return (
                        <tr>
                          <td class="nm">
                            {label.href ? <a href={label.href}>{label.name}</a> : label.name}
                          </td>
                          <td class="dim">{metric?.name ?? m.metric}</td>
                          <td class="num">
                            {m.status === "ok" ? (m.value_num ?? m.value) : "—"}
                          </td>
                          <td class="dim mono">{m.subject_version ?? "—"}</td>
                          <td class="dim">{m.status === "ok" ? "" : `${m.status}: ${m.note ?? ""}`}</td>
                        </tr>
                      );
                    })}
                  </tbody>
                </table>
              </div>
            ))}
          </>
        )
      }

      <div class="sech" style="padding-top:0">
        <h2>Candidates</h2>
        <div class="rule"></div>
        <span class="note">{all.length} tools · {documented.length} read from source</span>
      </div>

      {
        documented.length > 0 ? (
          <div class="scroller">
            <table class="data">
              <thead>
                <tr>
                  <th>Owner</th>
                  <th>Tool</th>
                  {splitKey && (
                    <th>
                      {splitKey.short ?? splitKey.label}
                      <span class="sub">choice</span>
                    </th>
                  )}
                  {headlineKeys.map((k) => (
                    <th>
                      {k.short ?? k.label}
                      <span class="sub">{k.class === "invariant" ? "invariant" : "choice"}</span>
                    </th>
                  ))}
                  <th>Source</th>
                </tr>
              </thead>
              <tbody>
                {documented.map((tool) => (
                  <tr id={tool.id} class={pickTool?.id === tool.id ? "hi" : undefined}>
                    <td class="nm">
                      <a href={tool.ownerRef.href}>{tool.ownerRef.name}</a>
                    </td>
                    <td class="mono">
                      <a href={tool.href}>{tool.exposed_name}</a>
                    </td>
                    {splitKey && (
                      <td>
                        <ObservationValue
                          keyDef={splitKey}
                          observation={tool.observations.find((o) => o.key === splitKey.key)}
                          fallbackSource={tool.source}
                        />
                      </td>
                    )}
                    {headlineKeys.map((k) => (
                      <td>
                        <ObservationValue
                          keyDef={k}
                          observation={tool.observations.find((o) => o.key === k.key)}
                          fallbackSource={tool.source}
                        />
                      </td>
                    ))}
                    <td class="dim">
                      {tool.source ? (
                        <a class="mono" href={tool.source.url}>
                          repo
                        </a>
                      ) : (
                        <span class="none">—</span>
                      )}
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        ) : (
          // An empty table with a header row and no body reads as "we looked
          // and found nothing". Nothing has been looked at yet, which is a
          // different claim and the one worth making.
          <p class="prose" style="font-size:14px">
            <b>Not surveyed yet.</b> No implementation of this capability has been read from source,
            so there is no comparison to show — only the list of what is on file, below. The
            dimensions worth comparing are decided by reading the implementations, not before.
          </p>
        )
      }

      {
        unstudied.length > 0 && (
          <p class="prose" style="font-size:14px">
            <b>Present but not verified.</b> {documented.length > 0 ? "Another " : ""}
            {unstudied.length} {plural(unstudied.length, "tool", "tools")}, registered by{" "}
            {unstudiedOwners} {plural(unstudiedOwners, "harness", "harnesses")},{" "}
            {plural(unstudied.length, "has", "have")} not been read from source:{" "}
            {unstudied.map((t, i) => (
              <>
                {i > 0 && ", "}
                <a href={t.href}>
                  {t.ownerRef.name} <code>{t.exposed_name}</code>
                </a>
              </>
            ))}
            .{" "}
            {documented.length > 0 &&
              "They are left out of the comparison rather than shown as empty rows — a blank cell would claim the behaviour is absent, which is a different thing from not having checked."}
          </p>
        )
      }

      {
        tables.length > 0 && (
          <>
            <div class="sech" style="padding-top:0">
              <h2>Full comparison</h2>
              <div class="rule" />
              <span class="note">every cell links to where it was read</span>
            </div>
            {tables.map((table) => (
              <div class="scroller matrix">
                <table class="data">
                  {table.label && <caption>{table.label}</caption>}
                  <thead>
                    <tr>
                      <th>Dimension</th>
                      {table.tools.map((t) => (
                        <th>
                          {t.ownerRef.name}
                          <span class="sub">{t.exposed_name}</span>
                        </th>
                      ))}
                    </tr>
                  </thead>
                  <tbody>
                    {table.groups.map((group) => (
                      <>
                        <tr class="sec">
                          <td colspan={table.tools.length + 1}>{group.group}</td>
                        </tr>
                        {group.keys.map(({ k, anchor }) => (
                          <tr id={anchor}>
                            <td class="nm wrap" title={k.description}>
                              {k.label}
                              {k.class === "invariant" && (
                                <span class="badge" style="margin-left:6px">
                                  invariant
                                </span>
                              )}
                            </td>
                            {table.tools.map((t) => (
                              <td>
                                <ObservationValue
                                  keyDef={k}
                                  observation={t.observations.find((o) => o.key === k.key)}
                                  fallbackSource={t.source}
                                />
                              </td>
                            ))}
                          </tr>
                        ))}
                      </>
                    ))}
                  </tbody>
                </table>
              </div>
            ))}
            <p class="prose" style="font-size:13.5px;color:var(--mute)">
              Rows marked <span class="badge">invariant</span> are things every implementation should
              hold to, so they render as pass/fail. Everything else is a design choice: differing is
              recorded, never scored. <span class="unk">?</span> means we could not verify it;{" "}
              <span class="none">—</span> means the question does not apply.
            </p>
          </>
        )
      }
    </div>
  </div>
</Base>
